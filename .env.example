# Киоск самообслуживания — Environment Configuration
# =======================================================
# Этот файл содержит шаблон переменных окружения для проекта.
# Копируйте его в `.env` и заполняйте реальными значениями.
#
# ⚠️ REMOVE BEFORE PROD: Все placeholder значения должны быть заменены
# на реальные секреты из HashiCorp Vault перед production запуском
#
# ВНИМАНИЕ: НЕ коммитьте `.env` с реальными секретами!
# =======================================================

# ===== РЕЖИМ ПРИЛОЖЕНИЯ =====
# Определяет поведение приложения: DEV, QA или PROD
# DEV: кнопка "Пропустить", моки устройств/платежей, детальное логирование
# QA: тестовые PSP, реальные устройства, средний уровень логов
# PROD: без кнопок "Пропустить", боевые PSP, минимальное логирование
APP_MODE=DEV

# ===== УСТРОЙСТВА =====
# Управление подключением к реальным устройствам

# Мок толщиномера (true = использовать mock, false = реальное BLE устройство)
DEVICE_MOCK_THICKNESS=false

# Мок OBD-адаптера (true = использовать mock, false = реальное устройство)
DEVICE_MOCK_OBD=false

# Arduino dispencer: COM-порт для Windows (например, COM3) или /dev/ttyACM0 для Linux
ARDUINO_PORT=COM3

# Arduino baud rate (по умолчанию 9600)
ARDUINO_BAUD_RATE=9600

# ===== ПЛАТЕЖИ =====
# Интеграция с платёжными шлюзами

# Мок платежей (true = имитация оплаты в DEV, false = реальный PSP)
PAYMENT_MOCK=true

# YooKassa Shop ID (получить на dashboard.yookassa.ru)
YOOKASSA_SHOP_ID=your_shop_id_here

# YooKassa Secret Key (СЕКРЕТ! НЕ коммитить!)
YOOKASSA_SECRET_KEY=your_secret_key_here

# YooKassa webhook secret для валидации входящих webhook-ов
YOOKASSA_WEBHOOK_SECRET=your_webhook_secret_here

# Encryption key для шифрования payment intents (AES-256, 32 байта hex)
PAYMENTS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ===== ОТЧЁТЫ =====
# Доставка отчётов через email/SMS

# Email service provider: MOCK, SENDGRID, SMTP
EMAIL_PROVIDER=MOCK

# SendGrid API Key (если EMAIL_PROVIDER=SENDGRID)
SENDGRID_API_KEY=your_sendgrid_api_key_here

# SMTP настройки (если EMAIL_PROVIDER=SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=noreply@kiosk.example.com

# SMS service provider: MOCK, TWILIO, SMSAERO
SMS_PROVIDER=MOCK

# Twilio Account SID (если SMS_PROVIDER=TWILIO)
TWILIO_ACCOUNT_SID=your_account_sid_here

# Twilio Auth Token (если SMS_PROVIDER=TWILIO)
TWILIO_AUTH_TOKEN=your_auth_token_here

# Twilio Phone Number (если SMS_PROVIDER=TWILIO)
TWILIO_PHONE_NUMBER=+1234567890

# ===== SUPABASE =====
# Backend-as-a-Service для отчётов, телеметрии, heartbeat
# Миграция: 24.11.2025 - новый сервер ddaunoxyguqiejrjtwsf.supabase.co
# Хранение: Vault kv/selfservice/platform/supabase/{env}/service

# Supabase Project URL (формат: https://<project_ref>.supabase.co)
SUPABASE_URL=<SUPABASE_URL>

# Supabase Anon Key (публичный ключ для клиентских запросов)
SUPABASE_ANON_KEY=<SUPABASE_ANON_KEY>

# Supabase Service Role Key (СЕКРЕТ! Только для server-side операций)
# НЕ коммитить реальное значение! Получать из Vault или CI переменных
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_KEY>

# Supabase JWT Secret (используется для валидации токенов)
SUPABASE_JWT_SECRET=<SUPABASE_JWT_SECRET>

# ===== POSTGRES (Supabase) =====
# Прямое подключение к PostgreSQL через Supabase

# PostgreSQL Database name
POSTGRES_DATABASE=postgres

# PostgreSQL Host
POSTGRES_HOST=<POSTGRES_HOST>

# PostgreSQL User
POSTGRES_USER=postgres

# PostgreSQL Password (СЕКРЕТ! Хранить в Vault)
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>

# PostgreSQL Connection URLs (для различных режимов подключения)
# Pooler URL (через pgbouncer, рекомендуется для serverless)
POSTGRES_URL=<POSTGRES_URL>

# Prisma URL (оптимизировано для Prisma ORM)
POSTGRES_PRISMA_URL=<POSTGRES_PRISMA_URL>

# Non-Pooling URL (прямое подключение, для миграций)
POSTGRES_URL_NON_POOLING=<POSTGRES_URL_NON_POOLING>

# ===== GREEN API (WhatsApp) =====
# Интеграция для отправки уведомлений через WhatsApp

# Green API Instance ID
GREEN_API_INSTANCE_ID=your_instance_id_here

# Green API Token
GREEN_API_TOKEN=your_green_api_token_here

# ===== ЛОГИРОВАНИЕ =====
# Уровень логов и настройки

# LOG_LEVEL: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=DEBUG

# Retention policy для логов (в днях)
LOG_RETENTION_DAYS=30

# Максимальный размер логов (в MB)
LOG_MAX_SIZE_MB=500

# ===== EDGE CACHE =====
# Локальное кеширование отчётов

# Включить edge cache (true/false)
EDGE_CACHE_ENABLED=true

# Путь к SQLite базе edge cache
EDGE_CACHE_DB_PATH=./data/edge_cache.db

# Retention для edge cache (в днях)
EDGE_CACHE_RETENTION_DAYS=30

# ===== МОНИТОРИНГ =====
# Интеграция с системами мониторинга

# Prometheus pushgateway URL (если используется)
PROMETHEUS_PUSHGATEWAY_URL=http://localhost:9091

# Grafana API Key (если используется)
GRAFANA_API_KEY=your_grafana_api_key_here

# ===== MDM/OTA =====
# Mobile Device Management и Over-The-Air updates

# MDM Provider: NONE, CUSTOM
MDM_PROVIDER=NONE

# Kiosk serial number (уникальный идентификатор киоска)
KIOSK_SERIAL_NUMBER=KIOSK-001

# Heartbeat interval (в секундах, по умолчанию 300 = 5 минут)
HEARTBEAT_INTERVAL_SEC=300

# ===== РАЗНОЕ =====

# Node.js агент порт (для локального тестирования)
NODE_AGENT_PORT=3000

# Android Debug Bridge (ADB) для инструментальных тестов
ADB_DEVICE_SERIAL=emulator-5554

# Включить mock данные для UI preview (true/false)
UI_MOCK_DATA=true

# ===== КОНЕЦ ФАЙЛА =====
# После заполнения переименуйте в `.env` и добавьте в .gitignore
# 
# ВАЖНО: В production все секреты должны храниться в HashiCorp Vault
# Пути Vault: kv/selfservice/platform/{service}/{env}/{key_name}
# Документация: 09-docs/02-application/security/credential-inventory.md
# 
# TODO: Перед production запуском удалите все placeholder значения и 
# настройте автоматическую подгрузку секретов из Vault через CI/CD
