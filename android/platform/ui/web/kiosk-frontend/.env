# ============================================================================
# Production kiosk configuration (never commit real secrets upstream)
# ============================================================================
VITE_SUPABASE_URL=https://ddaunoxyguqiejrjtwsf.supabase.co
# TODO: заменить на реальный anon key из Supabase Settings > API
VITE_SUPABASE_ANON_KEY=__REPLACE_WITH_PROD_ANON_KEY__

# Режим работы закреплён в PROD
VITE_APP_MODE=PROD

# Уникальный идентификатор киоска
VITE_KIOSK_ID=kiosk-prod-001

# Защитные флаги (в production все dev-настройки выключены)
VITE_ENABLE_SKIP_BUTTON=false
VITE_DEVICE_MOCK_THICKNESS=false
VITE_DEVICE_MOCK_OBD=false
VITE_PAYMENT_MOCK=false

# Таймауты и авто-сброс
VITE_SESSION_TIMEOUT_MS=300000
VITE_AUTO_RESET_MS=30000

# Фичи и мониторинги
VITE_SHOW_DELIVERY_MONITOR=true
VITE_ENABLE_CLEAR_DTC=true
