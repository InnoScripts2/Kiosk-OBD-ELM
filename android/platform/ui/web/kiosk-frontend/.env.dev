# ============================================================================
# Development kiosk configuration (offline/local mode)
# ============================================================================
# Скопируйте этот файл в .env для локальной разработки:
#   cp .env.dev .env
#
# Supabase отключён для локальной разработки без облачного доступа
# Для подключения к реальному Supabase:
# 1. Скопируйте .env.example в .env
# 2. Замените VITE_SUPABASE_ANON_KEY на реальный ключ
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Режим работы: DEV для локальной разработки
VITE_APP_MODE=DEV

# Уникальный идентификатор киоска
VITE_KIOSK_ID=kiosk-dev-001

# DEV-режим: включены mock-режимы и кнопка пропуска
VITE_ENABLE_SKIP_BUTTON=true
VITE_DEVICE_MOCK_THICKNESS=true
VITE_DEVICE_MOCK_OBD=true
VITE_PAYMENT_MOCK=true

# Таймауты и авто-сброс
VITE_SESSION_TIMEOUT_MS=300000
VITE_AUTO_RESET_MS=30000

# Фичи и мониторинги
VITE_SHOW_DELIVERY_MONITOR=false
VITE_ENABLE_CLEAR_DTC=true
