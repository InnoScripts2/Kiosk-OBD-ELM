# ============================================================================
# Kiosk configuration
# ============================================================================
# Режим работы: DEV | QA | PROD
VITE_APP_MODE=PROD

# Идентификатор киоска (если задан, передаётся в kiosk_id)
VITE_KIOSK_ID=

# Включить кнопку «Пропустить» (только DEV/QA, автоматически скрыта в PROD)
VITE_ENABLE_SKIP_BUTTON=false

# Симуляция устройств (только DEV/QA)
VITE_DEVICE_MOCK_THICKNESS=false
VITE_DEVICE_MOCK_OBD=false

# Симуляция платежей (только DEV/QA)
VITE_PAYMENT_MOCK=false

# ============================================================================
# Timeouts and intervals
# ============================================================================
# Таймаут сессии (мс, по умолчанию 5 минут)
VITE_SESSION_TIMEOUT_MS=300000

# Интервал авто-сброса (мс, по умолчанию 30 секунд после завершения)
VITE_AUTO_RESET_MS=30000

# ============================================================================
# Feature flags
# ============================================================================
# Отображать Supabase монитор очереди на экранах завершения
VITE_SHOW_DELIVERY_MONITOR=true

# Показывать кнопку «Сбросить ошибки» в диагностике
VITE_ENABLE_CLEAR_DTC=true
