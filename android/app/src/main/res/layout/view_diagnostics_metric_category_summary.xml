<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/categorySummaryRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_diagnostics_metric_summary"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/categorySummaryTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/diagnostics_metric_category_summary_title"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/categorySummaryRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical" />

</LinearLayout>