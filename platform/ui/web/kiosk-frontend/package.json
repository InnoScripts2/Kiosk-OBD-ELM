{
  "name": "@selfservice/kiosk-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kiosk self-service frontend (vanilla JS + Vite)",
  "scripts": {
    "predev": "npm run sync:supabase-types",
    "prebuild": "npm run sync:supabase-types",
    "pretest": "npm run sync:supabase-types",
    "pretypecheck": "npm run sync:supabase-types",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "lint": "eslint src --ext .js",
    "typecheck": "tsc --noEmit",
    "sync:supabase-types": "node ./scripts/sync-supabase-types.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.8.3",
    "@playwright/test": "^1.40.1",
    "@types/ejs": "^3.1.5",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^20.10.6",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vite-plugin-html": "^3.2.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0"
  }
}