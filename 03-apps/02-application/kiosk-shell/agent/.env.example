# Kiosk Shell Agent — Environment Configuration Template
# =======================================================
# Копируйте файл в `.env` и заполняйте реальными значениями из Vault.
# НЕ коммитьте `.env` с реальными секретами!
# =======================================================

# ===== РЕЖИМ ПРИЛОЖЕНИЯ =====
NODE_ENV=development
APP_MODE=DEV
LOG_LEVEL=debug

# ===== SUPABASE =====
# Backend для отчётов, edge-cache и телеметрии
# Миграция: 24.11.2025 - новый сервер ddaunoxyguqiejrjtwsf.supabase.co
# Vault path: kv/selfservice/platform/supabase/{env}/service

# Supabase Project URL (формат: https://<project_ref>.supabase.co)
SUPABASE_URL=https://ddaunoxyguqiejrjtwsf.supabase.co

# Supabase Anon Key (публичный ключ)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRkYXVub3h5Z3VxaWVqcmp0d3NmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjM5NTQ0MjYsImV4cCI6MjA3OTUzMDQyNn0.eV2J8CYHMEEahKzH7QTYpKyRAwKmbh-vE5xi2zf-Drg

# Supabase Service Role Key (СЕКРЕТ! Только для server-side)
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_KEY>

# ===== POSTGRES (Supabase) =====
# Для прямого подключения к БД (миграции, аналитика)

POSTGRES_DATABASE=postgres
POSTGRES_HOST=db.ddaunoxyguqiejrjtwsf.supabase.co
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>

# Connection URLs
POSTGRES_URL=<POSTGRES_URL>
POSTGRES_PRISMA_URL=<POSTGRES_PRISMA_URL>
POSTGRES_URL_NON_POOLING=<POSTGRES_URL_NON_POOLING>

# ===== ПЛАТЕЖИ =====
PAYMENT_MOCK=true

# YooKassa (PSP)
YOOKASSA_SHOP_ID=<YOOKASSA_SHOP_ID>
YOOKASSA_SECRET_KEY=<YOOKASSA_SECRET_KEY>
YOOKASSA_WEBHOOK_SECRET=<YOOKASSA_WEBHOOK_SECRET>

# Encryption key для payment intents
PAYMENTS_ENCRYPTION_KEY=<PAYMENTS_ENCRYPTION_KEY>

# ===== УСТРОЙСТВА =====
DEVICE_MOCK_OBD=false
DEVICE_MOCK_THICKNESS=false

# Arduino (замки/реле)
ARDUINO_PORT=COM3
ARDUINO_BAUD=9600
ARDUINO_COMMAND_TIMEOUT=10000
ARDUINO_RECONNECT_DELAY=5000
ARDUINO_HEARTBEAT_INTERVAL=30000

# ===== ОТЧЁТЫ =====
# Email
EMAIL_PROVIDER=MOCK
SENDGRID_API_KEY=<SENDGRID_API_KEY>

# SMS
SMS_PROVIDER=MOCK
TWILIO_ACCOUNT_SID=<TWILIO_ACCOUNT_SID>
TWILIO_AUTH_TOKEN=<TWILIO_AUTH_TOKEN>
TWILIO_PHONE_NUMBER=<TWILIO_PHONE_NUMBER>

# ===== GREEN API (WhatsApp) =====
GREEN_API_INSTANCE_ID=<GREEN_API_INSTANCE_ID>
GREEN_API_TOKEN=<GREEN_API_TOKEN>

# ===== EDGE CACHE =====
EDGE_CACHE_ENABLED=true
EDGE_CACHE_DB_PATH=./data/edge_cache.db
EDGE_CACHE_RETENTION_DAYS=30

# ===== МОНИТОРИНГ =====
KIOSK_SERIAL_NUMBER=KIOSK-001
HEARTBEAT_INTERVAL_SEC=300

# ===== СЕРВЕР =====
NODE_AGENT_PORT=7070

# ===== КОНЕЦ ФАЙЛА =====
