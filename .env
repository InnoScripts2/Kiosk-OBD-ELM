# Supabase configuration (для будущей интеграции)
VITE_SUPABASE_URL=https://your-supabase-project-url
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Application mode configuration
NODE_ENV=development
APP_MODE=DEV
LOG_LEVEL=debug

# Payment configuration
PAYMENT_MOCK=true

# Device simulation flags
DEVICE_MOCK_OBD=false
DEVICE_MOCK_THICKNESS=false

# Arduino configuration for lock control
ARDUINO_PORT=/dev/ttyUSB0
ARDUINO_BAUD=9600
ARDUINO_COMMAND_TIMEOUT=10000
ARDUINO_RECONNECT_DELAY=5000
ARDUINO_HEARTBEAT_INTERVAL=30000
