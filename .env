# Supabase configuration
# TODO: Удалить реальные значения перед пушем! Использовать только в DEV локально.
# В CI/CD и production значения подтягиваются из Vault через скрипты export-supabase-service-key.ps1
# Миграция: 24.11.2025 - новый сервер ddaunoxyguqiejrjtwsf.supabase.co
# Vault path: kv/selfservice/platform/supabase/dev/service

NEXT_PUBLIC_SUPABASE_ANON_KEY="<SUPABASE_ANON_KEY>"
NEXT_PUBLIC_SUPABASE_URL="<SUPABASE_URL>"
POSTGRES_DATABASE="postgres"
POSTGRES_HOST="<POSTGRES_HOST>"
POSTGRES_PASSWORD="<POSTGRES_PASSWORD>"
POSTGRES_PRISMA_URL="<POSTGRES_PRISMA_URL>"
POSTGRES_URL="<POSTGRES_URL>"
POSTGRES_URL_NON_POOLING="<POSTGRES_URL_NON_POOLING>"
POSTGRES_USER="postgres"
SUPABASE_ANON_KEY="<SUPABASE_ANON_KEY>"
SUPABASE_JWT_SECRET="<SUPABASE_JWT_SECRET>"
SUPABASE_SERVICE_ROLE_KEY="<SUPABASE_SERVICE_ROLE_KEY>"
SUPABASE_URL="<SUPABASE_URL>"
# Application mode configuration
NODE_ENV=development
APP_MODE=DEV
LOG_LEVEL=debug

# Payment configuration
PAYMENT_MOCK=true

# Device simulation flags
DEVICE_MOCK_OBD=false
DEVICE_MOCK_THICKNESS=false

# Arduino configuration for lock control
ARDUINO_PORT=/dev/ttyUSB0
ARDUINO_BAUD=9600
ARDUINO_COMMAND_TIMEOUT=10000
ARDUINO_RECONNECT_DELAY=5000
ARDUINO_HEARTBEAT_INTERVAL=30000
